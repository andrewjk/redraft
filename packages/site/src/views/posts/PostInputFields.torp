import { Field, File, Hidden, Input, Select, Option, TextArea, Message } from "@torpor/ui/Form";
import { ALLOWED_FILE_ACCEPT } from "../../lib/constants";
import cleanImage from "../../lib/utils/cleanImage";
import type UserModel from "../../types/UserModel";
import type PostEditModel from "../../types/posts/PostEditModel";
import ImageUpload from "../ImageUpload.torp";
import LinkPreview from "./LinkPreview.torp";
import Article from "phosphor-torpor/lib/Article";
import Calendar from "phosphor-torpor/lib/Calendar";
import CaretDown from "phosphor-torpor/lib/CaretDown";
import CaretUp from "phosphor-torpor/lib/CaretUp";
import Heart from "phosphor-torpor/lib/Heart";
import Image from "phosphor-torpor/lib/Image";
import Link from "phosphor-torpor/lib/Link";
import Paperclip from "phosphor-torpor/lib/Paperclip";
import Stack from "phosphor-torpor/lib/Stack";
import StackPlus from "phosphor-torpor/lib/StackPlus";
//import Star from "phosphor-torpor/lib/Star";
import Tag from "phosphor-torpor/lib/Tag";
import ThumbsDown from "phosphor-torpor/lib/ThumbsDown";
import ThumbsUp from "phosphor-torpor/lib/ThumbsUp";
import Trash from "phosphor-torpor/lib/Trash";
import UsersThree from "phosphor-torpor/lib/UsersThree";
import X from "phosphor-torpor/lib/X";

/**
 * Allows creating a post.
 */
export default function PostInputFields($props: { post: PostEditModel, child?: PostEditModel, i?: number, user: UserModel, base: string }) {
	let user = $props.user;
	let post = $watch($props.child ?? $props.post ?? newPost());
	let child = $props.child;
	// NOTE: this is a function so that `$props.i` is read reactively when the
	// form field names are set -- the `i` of a child can change when children
	// are added or removed
	let prefix = () => ($props.child ? `children[${$props.i}]` : "");

	let $state = $watch({
		imageLoaded: !!post.image,
		linkLoading: false,
		linkLoaded: !!post.linkUrl,
		linkImageLoaded: !!post.linkImage,
		showTags: !!post.tags,
		showVisibility: !!post.visibility,
		get lists() {
			return $async(() => loadLists());
		}
	});

	// New posts get a negative id (so they can be told apart from saved posts
	// when the form is submitted). It is one less than the lowest existing id
	// so that keys stay unique even when children are added from different
	// PostInputFields instances
	function newPost() {
		let children = $props.post?.children ?? [];
		return { id: Math.min(0, ...children.map((c) => c.id)) - 1, slug: "", text: "" };
	}

	async function loadLists() {
		const url = `${$props.base}contacts/lists/~server`;
		const response = await fetch(url, { credentials: "same-origin" });
		if (!response.ok) {
			throw new Error();
		}
		const data = await response.json();
		return data.lists;
	}

	@render {
		<div style="display: contents;">
			<Hidden name={`${prefix()}id`} value={post.id} />
			<Hidden name={`${prefix()}published`} value={post.published} />
			<Hidden name={`${prefix()}hasImage`} value={post.hasImage} />
			<Hidden name={`${prefix()}hasLink`} value={post.hasLink} />
			<Hidden name={`${prefix()}hasRating`} value={post.hasRating} />
			<Hidden name={`${prefix()}isArticle`} value={post.isArticle} />
			<Hidden name={`${prefix()}isEvent`} value={post.isEvent} />

			<Field class="form-row" name={`${prefix()}text`} &value={post.text}>
				<TextArea
					placeholder="Post something…"
					rows={3}
				/>
				<Message class="error-message" />
			</Field>

			@if (post.isArticle) {
				<Hidden name={`${prefix()}articleId`} value={post.articleId} />
				<Hidden name={`${prefix()}linkPublication`} value={user.name} />

				<Field class="form-row" name={`${prefix()}linkTitle`} &value={post.linkTitle}>
					<Input
						class="post-input-article-title"
						required
						placeholder="Title"
					/>
					<Message class="error-message" />
				</Field>
				<Hidden name={`${prefix()}linkImage`} value={post.linkImage} />
				<ImageUpload name={`${prefix()}linkimagefile`} image={post.linkimagefile ?? post.linkImage} imageLoaded={$state.linkImageLoaded} class="full-width" />
				<Field class="form-row" name={`${prefix()}articleText`} &value={post.articleText}>
					<TextArea placeholder="Article text" />
					<Message class="error-message" />
				</Field>
			} else if (post.isEvent) {
				<Hidden name={`${prefix()}eventId`} value={post.eventId} />
				<Hidden name={`${prefix()}linkPublication`} value={user.name} />

				<Field class="form-row" name={`${prefix()}linkTitle`} &value={post.linkTitle}>
					<Input
						class="post-input-event-title"
						required
						placeholder="Title"
					/>
					<Message class="error-message" />
				</Field>
				<Hidden name={`${prefix()}linkImage`} value={post.linkImage} />
				<ImageUpload name={`${prefix()}linkimagefile`} image={post.linkimagefile ?? post.linkImage} imageLoaded={$state.linkImageLoaded} class="full-width" />
				<Field class="form-row" name={`${prefix()}eventText`} &value={post.eventText}>
					<TextArea placeholder="Event description" />
					<Message class="error-message" />
				</Field>
				<Field class="form-row" name={`${prefix()}eventLocation`} &value={post.eventLocation}>
					<Input placeholder="Event location" />
					<Message class="error-message" />
				</Field>
				<Field class="form-row" name={`${prefix()}eventStartsAt`} &value={post.eventStartsAt}>
					<Input
						type="date"
						placeholder="Event start" />
					<Message class="error-message" />
				</Field>
				<Field class="form-row" name={`${prefix()}eventDuration`} &value={post.eventDuration}>
					<Input
						type="number"
						placeholder="Event duration (minutes)" />
					<Message class="error-message" />
				</Field>

				<Hidden name={`${prefix()}eventRsvpEnabled`} value={post.eventRsvpEnabled} />
				<div class="hstack centered spaced-nr">
					<label>Allow RSVPs</label>
					<button
						type="button"
						class={{"rsvp-toggle": true, "selected": !!post.eventRsvpEnabled}}
						onclick={() => post.eventRsvpEnabled = !post.eventRsvpEnabled}
					>
						{post.eventRsvpEnabled ? "On" : "Off"}
					</button>
				</div>
				@if (post.eventRsvpEnabled) {
					<Field class="form-row" name={`${prefix()}eventRsvpLimit`} &value={post.eventRsvpLimit}>
						<Input
							type="number"
							placeholder="RSVP limit, e.g. 30 (optional)" />
						<Message class="error-message" />
					</Field>
					<Field class="form-row" name={`${prefix()}eventRsvpDeadline`} &value={post.eventRsvpDeadline}>
						<Input
							type="datetime-local"
							placeholder="RSVP deadline (optional)" />
						<Message class="error-message" />
					</Field>
				}
			} else {
				@if (post.hasImage) {
					<Hidden name={`${prefix()}image`} value={post.image} />
					<Hidden name={`${prefix()}isFile`} value={post.isFile} />
					@if (post.isFile) {
						<File
							name={`${prefix()}imagefile`}
							accept={ALLOWED_FILE_ACCEPT}
							onchange={fileSelected}
						/>
						@if (post.image || post.imageAltText) {
							<div class="hstack centered spaced-nr secondary">
								<Paperclip />
								<span>{post.imageAltText ?? "Attached file"}</span>
							</div>
						}
						@function fileSelected(e: Event) {
							let fileInput = (e.target as HTMLInputElement);
							let file = fileInput.files![0];
							if (file) {
								post.imageAltText = file.name;
							}
						}
					} else {
						<File
							style={{ display: $state.imageLoaded ? "none" : undefined }}
							name={`${prefix()}imagefile`}
							accept="image/*"
							onchange={imageSelected}
						/>
						@if (post.imagefile ?? post.image) {
							<img src={post.imagefile ?? post.image} />
							<Field class="form-row" name={`${prefix()}imageAltText`} &value={post.imageAltText}>
								<Input placeholder="Image alt text" />
								<Message class="error-message" />
							</Field>
						}
						@async function imageSelected(e: Event) {
							let fileInput = (e.target as HTMLInputElement);
							let image = fileInput.files![0];
							if (!image.type.startsWith("image/")) {
								return;
							}
							image = await cleanImage(image);
							let dataTransfer = new DataTransfer();
							dataTransfer.items.add(image);
							fileInput.files = dataTransfer.files;
							let fileReader = new FileReader();
							fileReader.onload = (ev) => {
								post.imagefile = ev.target!.result;
								$state.imageLoaded = true;
							}
							fileReader.readAsDataURL(image);
						}
					}
				} else if (post.hasLink) {
					<Hidden name={`${prefix()}linkImage`} value={post.linkImage} />
					<Hidden name={`${prefix()}linkTitle`} value={post.linkTitle} />
					<Hidden name={`${prefix()}linkPublication`} value={post.linkPublication} />
					<Hidden name={`${prefix()}linkEmbedSrc`} value={post.linkEmbedSrc} />
					<Hidden name={`${prefix()}linkEmbedWidth`} value={post.linkEmbedWidth} />
					<Hidden name={`${prefix()}linkEmbedHeight`} value={post.linkEmbedHeight} />

					<Field class="form-row" name={`${prefix()}linkUrl`} &value={post.linkUrl}>
						<Input
							type="url"
							style={{ display: $state.linkLoaded ? "none" : undefined }}
							placeholder="Link URL"
							oninput={async (e: Event) => {
								// TODO: Debounce
								const value = (e.target as HTMLInputElement).value;
								if (value) {
									$state.linkLoading = true;
									$state.linkLoaded = false;
									const response = await fetch(`/api/posts/link-info?url=${value}`, { credentials: "same-origin" });
									const info = await response.json()
									$state.linkLoading = false;
									if (info) {
										$state.linkLoaded = true;
										post.linkTitle = info.title;
										post.linkImage = info.image;
										post.linkPublication = info.publication;
										post.linkEmbedSrc = info.embedSrc;
										post.linkEmbedWidth = info.embedWidth;
										post.linkEmbedHeight = info.embedHeight;
									}
								}
							}} />
						@if ($state.linkLoading) {
							<div>Loading...</div>
						} else if (post.linkUrl) {
							<LinkPreview link={post} />
						}
						<Message class="error-message" />
					</Field>
				}

				@if (post.hasRating) {
					<Hidden name={`${prefix()}ratingValue`} &value={post.ratingValue} />

					<div class="hstack centered spaced-nr">
						<div class="spacer" />
						<label>Rating:</label>
						<div class="post-input-rating-container">
							<button
								type="button"
								class={{"post-input-rating": true, "selected": post.ratingValue === 1 }}
								style="padding: 0.4rem 0.5rem 0.4rem 1rem"
								onclick={() => changeRating(1)}
							>
								<ThumbsDown />
							</button>
							<button
								type="button"
								class={{"post-input-rating": true, "selected": post.ratingValue === 3 }}
								style="padding: 0.4rem 0.5rem 0.4rem 0.5rem"
								onclick={() => changeRating(3)}
							>
								<ThumbsUp />
							</button>
							<button
								type="button"
								class={{"post-input-rating": true, "selected": post.ratingValue === 5 }}
								style="padding: 0.4rem 1rem 0.4rem 0.5rem"
								onclick={() => changeRating(5)}
							>
								<Heart />
							</button>
						</div>
						@function changeRating(value: number) {
							post.ratingValue = post.ratingValue === value ? 0 : value;
						}
						<div class="spacer" />
					</div>
				}
			}

			@if ($state.showTags) {
				<Field class="form-row" name={`${prefix()}tags`} &value={post.tags}>
					<Input placeholder="Tags (separate with semicolons)" />
					<Message class="error-message" />
				</Field>
			}

			@if ($state.showVisibility) {
				<Field class="form-row" name={`${prefix()}visibility`} &value={post.visibility}>
					<Select>
						<Option value={0}>Public</Option>
						<Option value={1}>Followers</Option>
						<Option value={2}>Private</Option>
						<Option value={3}>Recipient list</Option>
					</Select>
				</Field>

				@if (parseInt(String(post.visibility)) === 3) {
					@try {
						@await {
							<Field class="form-row" name={`${prefix()}listId`} &value={post.listId}>
								<Select>
									@for (let list of $state.lists ?? []) {
										<Option value={list.id}>{list.name}</Option>
									}
								</Select>
							</Field>
						} with {
							<p>Loading...</p>
						}
					} catch {
						<p>Something went wrong...</p>
					}
				}
			}

			<div class="hstack centered spaced post-input-footer">
				<div class="spacer" />
				<button
					type="button"
					class="link icon"
					title={post.hasImage && !post.isFile ? "Remove image" : "Add image"}
					disabled={
						post.isArticle || post.isEvent || post.hasLink || (post.hasImage && post.isFile)
					}
					onclick={toggleImage}
				>
					@if (post.hasImage && !post.isFile) {
						<div class="zstack">
							<X size="28px" />
							<Image />
						</div>
					} else {
						<Image />
					}
				</button>
				@function toggleImage() {
					if (post.hasImage && !post.isFile) {
						post.hasImage = false;
					} else {
						post.hasImage = true;
						post.isFile = false;
						clearAttachment();
						$state.imageLoaded = false;
					}
				}
				@if (!child) {
					<button
						type="button"
						class="link icon"
						title={post.hasImage && post.isFile ? "Remove file" : "Add file"}
						disabled={
							post.isArticle || post.isEvent || post.hasLink || (post.hasImage && !post.isFile)
						}
						onclick={toggleFile}
					>
						@if (post.hasImage && post.isFile) {
							<div class="zstack">
								<X size="28px" />
								<Paperclip />
							</div>
						} else {
							<Paperclip />
						}
					</button>
				}
				@function toggleFile() {
					if (post.hasImage && post.isFile) {
						post.hasImage = false;
					} else {
						post.hasImage = true;
						post.isFile = true;
						clearAttachment();
					}
				}
				@function clearAttachment() {
					post.image = undefined;
					post.imageAltText = undefined;
					post.imagefile = undefined;
				}
				<button
					type="button"
					class="link icon"
					title={post.hasLink ? "Remove link" : "Add link"}
					disabled={post.isArticle || post.isEvent || post.hasImage}
					onclick={toggleLink}
				>
					@if (post.hasLink) {
						<div class="zstack">
							<X size="28px" />
							<Link />
						</div>
					} else {
						<Link />
					}
				</button>
				@function toggleLink() {
					post.hasLink = !post.hasLink;
					if (post.hasLink) {
						$state.linkLoaded = false;
					}
				}
				<button type="button" class="link icon" disabled={post.isArticle || post.isEvent} onclick={() => post.hasRating = !post.hasRating}>
					@if (post.hasRating) {
						<div class="zstack">
							<X size="28px" />
							<ThumbsUp />
						</div>
					} else {
						<ThumbsUp />
					}
				</button>
				@if (!child) {
					<button type="button" class="link icon" disabled={post.hasImage || post.hasLink || post.hasRating || (post.children && post.children.length > 0)} onclick={toggleArticle}>
						@if (post.isArticle) {
							<div class="zstack">
								<X size="28px" />
								<Article />
							</div>
						} else {
							<Article />
						}
					</button>
					@function toggleArticle() {
						post.hasLink = false;
						post.isArticle = !post.isArticle;
						clearLink();
					}
					<button type="button" class="link icon" disabled={post.hasImage || post.hasLink || post.hasRating || (post.children && post.children.length > 0)} onclick={toggleEvent}>
						@if (post.isEvent) {
							<div class="zstack">
								<X size="28px" />
								<Calendar />
							</div>
						} else {
							<Calendar />
						}
					</button>
					@function toggleEvent() {
						post.hasLink = false;
						post.isEvent = !post.isEvent;
						clearLink();
					}
				}
				@function clearLink() {
					post.linkUrl = undefined;
					post.linkTitle = undefined;
					post.linkImage = undefined;
					post.linkPublication = undefined;
					post.linkEmbedSrc = undefined;
					post.linkEmbedWidth = undefined;
					post.linkEmbedHeight = undefined;
				}
				@if (child) {
					<button
						type="button"
						class="link icon"
						title="Move up"
						disabled={($props.i ?? 0) === 0}
						onclick={() => moveChild(-1)}
					>
						<CaretUp />
					</button>
					<button
						type="button"
						class="link icon"
						title="Move down"
						disabled={($props.i ?? 0) === ($props.post.children?.length ?? 0) - 1}
						onclick={() => moveChild(1)}
					>
						<CaretDown />
					</button>
					<button type="button" class="link icon" title="Remove post" onclick={removeChild}>
						<div class="zstack">
							<X size="28px" />
							<Stack />
						</div>
					</button>
				}
				@function moveChild(offset: number) {
					let i = $props.i !== undefined ? $props.i : 0;
					let children = ($props.post.children ??= []);
					let j = i + offset;
					if (j < 0 || j >= children.length) return;
					[children[i], children[j]] = [children[j], children[i]];
				}
				@function removeChild() {
					let i = $props.i !== undefined ? $props.i : 0;
					($props.post.children ??= []).splice(i, 1);
				}
				<button type="button" class="link icon" title="Add post" disabled={post.isArticle || post.isEvent} onclick={addChild}>
					<StackPlus />
				</button>
				@function addChild() {
					let i = $props.i !== undefined ? $props.i + 1 : 0;
					($props.post.children ??= []).splice(i, 0, newPost());
				}
				@if (!child) {
					<button type="button" class="link icon" onclick={() => $state.showTags = !$state.showTags}>
						@if ($state.showTags) {
							<div class="zstack">
								<X size="28px" />
								<Tag />
							</div>
						} else {
							<Tag />
						}
					</button>
					<button type="button" class="link icon" onclick={() => $state.showVisibility = !$state.showVisibility}>
						@if ($state.showVisibility) {
							<div class="zstack">
								<X size="28px" />
								<UsersThree />
							</div>
						} else {
							<UsersThree />
						}
					</button>
				}
			</div>
			@if ($props.post.children?.length === 0 || $props.i === $props.post.children!.length -1) {
				<div class="hstack centered spaced post-input-footer">
					<div class="spacer" />
					<button type="submit" formaction="?/savePost">
						{$props.post.published ? "Save" : "Save draft"}
					</button>
					<button type="submit" formaction="?/publishPost">
						{$props.post.published ? "Republish" : "Publish"}
					</button>
					@if ($props.post.id > -1) {
						<a href="{$props.base}posts/delete/{$props.post.slug}" style="color: red" class="hstack centered spaced-nr">
							<Trash />
							Delete
						</a>
					}
				</div>
			}
		</div>
	}

	@style {
		.post-input-article-title {
			font-size: x-large;
		}

		.post-input-rating-container {
			border: 1px solid var(--muted);
			border-radius: 8rem;
			display: flex;
			flex-direction: row;
			align-items: center;
			overflow: hidden;
			padding: 0;
		}

		.post-input-rating {
			all: unset;
			color: var(--muted);
			cursor: pointer;
			font-size: 2rem;
		}

		.post-input-rating.selected {
			color: inherit;
		}

		.rsvp-toggle {
			background-color: var(--surface-alt);
			border: 1px solid var(--border-color);
			border-radius: var(--border-radius);
			cursor: pointer;
			padding: 0.2rem 0.8rem;
		}

		.rsvp-toggle.selected {
			background-color: var(--link);
			color: white;
		}
	}
}
