import { Form } from "@torpor/ui/Form";
import placeholdify from "../../lib/utils/placeholdify";
import relativeTimeSince from "../../lib/utils/relativeTimeSince"
import stripProtocol from "../../lib/utils/stripProtocol";
import type UserModel from "../../types/UserModel";
import type FollowerModel from "../../types/FollowerModel";
import type PostViewModel from "../../types/posts/PostViewModel";
import CommentList from "../comments/CommentList.torp"
import CalendarPlus from "phosphor-torpor/lib/CalendarPlus";
import ChatCircle from "phosphor-torpor/lib/ChatCircle";
import Heart from "phosphor-torpor/lib/Heart";
import Pencil from "phosphor-torpor/lib/Pencil";

/**
 * Shows an event's full details.
 */
export default function EventViewPage($props: { data: { post: PostViewModel, user: UserModel, follower: FollowerModel, base: string } }) {
	let { post, user, follower } = $props.data;
	let isOwner = user?.url === post.author.url;

	let fmt = new Intl.DateTimeFormat(undefined, {
		day: "numeric",
		month: "short",
		year: "numeric",
		hour: "numeric",
		minute: "numeric"
	});

	@head {
		<meta name="description" content={post.text} />
		<meta property="og:type" content="event" />
		@// <meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content="Redraft" />
		<meta property="og:title" content={post.linkTitle} />
		<meta property="og:description" content={""} />
		<meta property="og:url" content="{post.author.url}posts/${post.slug}" />
		@// <meta property="og:image" content="" />
		@// <meta property="og:image:width" content="1152" />
		@// <meta property="og:image:height" content="648" />
		@// <meta property="og:image:alt" content="todo" />
		@if (post.publishedAt) {
			<meta property="article:published_time" content={(new Date(post.publishedAt)).toISOString()} />
		}
		@if (post.republishedAt) {
			<meta property="article:modified_time" content={(new Date(post.republishedAt!)).toISOString()} />
		}
	}

	@render {
		<div class="card full-width event-view">
			<div class="event-view-container">
				<div class="hstack spaced">
					<div class="no-shrink">
						<a href={post.author.url}>
							<img class="event-view-image" src={placeholdify(post.author.image)} alt="{post.author.name} ({stripProtocol(post.author.url)})" />
						</a>
					</div>
					<div class="grow">
						<div class="event-view-header hstack centered spaced font-sm">
							<a class="event-view-link hstack spaced grow" href={post.author.url}>
								<div class="vstack">
									<div class="event-view-name">
										{post.author.name}
									</div>
									<div class="event-view-url secondary">
										{stripProtocol(post.author.url)}
									</div>
								</div>
							</a>
							<div class="vstack align-end">
								<div class="event-view-time secondary" title={fmt.format(new Date(post.publishedAt))}>
									{relativeTimeSince(new Date(post.publishedAt))}
								</div>
								@if (user?.url === post.author.url) {
									<a href="{$props.data.base}posts/edit/{post.slug}" class="icon">
										<Pencil weight="bold" />
									</a>
								} else {
									<span>&nbsp;</span>
								}
							</div>
						</div>

						<div class="event-view-body">
							<h3>{post.linkTitle}</h3>
							<p>Where: {post.eventLocation}</p>
							<p>When: {fmt.format(new Date(post.eventStartsAt!))}</p>
							@if (post.eventDuration) {
								<p>Duration: {post.eventDuration} minutes</p>
							}
							@html(post.eventText!)
						</div>

						<div class="hstack centered spaced-nr event-view-actions font-sm">
							<a class="event-view-calendar" href="{$props.data.base}events/{post.slug}/ical" download>
								<CalendarPlus weight="bold" />
								Add to calendar
							</a>
						</div>

						@if (post.eventRsvpEnabled) {
							<div class="event-view-rsvp vstack spaced-nr">
								<div class="hstack centered spaced-nr font-sm secondary">
									<span>{post.eventRsvpGoingCount} going</span>
									@if (post.eventRsvpMaybeCount) {
										<span>•</span>
										<span>{post.eventRsvpMaybeCount} maybe</span>
									}
									@if (post.eventRsvpDeclinedCount) {
										<span>•</span>
										<span>{post.eventRsvpDeclinedCount} can't go</span>
									}
									@if (post.eventRsvpLimit) {
										<span>•</span>
										<span>{spotsLeft()} spots left</span>
									}
								</div>

								@if (post.eventRsvpDeadline) {
									<div class="font-sm secondary">
										RSVP by {fmt.format(new Date(post.eventRsvpDeadline))}
									</div>
								}

								@if (!isOwner && (user || follower)) {
									<Form class="hstack centered spaced" action="?/rsvp">
										<button
											type="submit"
											name="status"
											value="1"
											class={{"rsvp-button": true, "selected": post.viewerRsvpStatus === 1}}
										>
											Going
										</button>
										<button
											type="submit"
											name="status"
											value="2"
											class={{"rsvp-button": true, "selected": post.viewerRsvpStatus === 2}}
										>
											Maybe
										</button>
										<button
											type="submit"
											name="status"
											value="3"
											class={{"rsvp-button": true, "selected": post.viewerRsvpStatus === 3}}
										>
											Can't go
										</button>
									</Form>
								}

								@if (isOwner && post.eventRsvps.length) {
									<div class="event-view-rsvp-list vstack spaced-nr">
										@for (let rsvp of post.eventRsvps) {
											<div class="hstack centered spaced-nr font-sm">
												<img class="event-view-rsvp-image" src={placeholdify(rsvp.image)} alt={rsvp.name} />
												<a href={rsvp.url}>{rsvp.name}</a>
												<span class="secondary">{rsvpStatusText(rsvp.status)}</span>
											</div>
										}
									</div>
								}
							</div>
						}
						@function spotsLeft() {
							return Math.max(0, (post.eventRsvpLimit ?? 0) - post.eventRsvpGoingCount);
						}
						@function rsvpStatusText(status: number) {
							switch (status) {
								case 1: return "is going";
								case 2: return "might go";
								case 3: return "can't go";
							}
						}

						@/*
						@if (post.tags.length) {
							<div class="event-view-tags-container">
								@for (let [i, tag] of post.tags.entries()) {
									@if (i > 0) {
										<span class="separator" />
									}
									<a href="{$props.data.base}tags/{tag}">{tag}</a>
								}
							</div>
						}
						*/

						<div class="event-view-footer hstack centered font-sm secondary">
							<span class="hstack centered spaced-nr">
								<ChatCircle weight="bold" />
								{post.commentCount}
							</span>
							<span class="hstack centered spaced-nr">
								<Heart weight="bold" />
								{post.likeCount}
							</span>
							@if (post.emojiFirst) {
								<span>{post.emojiFirst}</span>
							}
							@if (post.emojiSecond) {
								<span>{post.emojiSecond}</span>
							}
							@if (post.emojiThird) {
								<span>{post.emojiThird}</span>
							}
							@for (let tag of post.tags) {
								<a href="{$props.data.base}tags/{tag.slug}">{tag.text}</a>
							}
						</div>
					</div>
				</div>
			</div>

			<div class="event-view-comments-container">
				<CommentList {post} {user} {follower} {post.comments}/>
			</div>
		</div>
	}

	@style {
		.event-view {
			margin: 0 auto;
			padding: 0;
		}

		.event-view-container,
		.event-view-comments-container {
			padding: 1rem;
		}

		.event-view-container {
			border-bottom: 1px solid var(--border-color);
		}

		.event-view-footer {
			gap: 2rem;
		}

		.event-view-body {
			padding: 1rem 0;
		}

		.event-view-actions {
			padding-bottom: 1rem;
		}

		.event-view-calendar {
			align-items: center;
			display: inline-flex;
			gap: 0.4rem;
		}

		.event-view-rsvp {
			border-top: 1px solid var(--border-color);
			padding-top: 1rem;
		}

		.event-view-rsvp-list {
			margin-top: 0.5rem;
		}

		.event-view-rsvp-image {
			border: 1px solid var(--border-color);
			border-radius: 50%;
			height: 24px;
			width: 24px;
		}

		.rsvp-button {
			background-color: var(--surface-alt);
			border: 1px solid var(--border-color);
			border-radius: var(--border-radius);
			cursor: pointer;
			padding: 0.4rem 1rem;
		}

		.rsvp-button.selected {
			background-color: var(--link);
			color: white;
		}

		.event-view-link {
			color: inherit;
			text-decoration: none;
		}

		.event-view-image {
			height: 40px;
			width: 40px;
			border: 1px solid var(--border-color);
			border-radius: 50%;
			box-shadow: 0 0.2rem 0.4rem var(--shadow-color);
		}

		.event-view-name {
			font-weight: bold;
		}

		.separator {
			margin: 0 0.5rem;
		}

		.event-view-comments-container {
			background-color: var(--surface-alt);
			border-radius: var(--border-radius);
			font-size: 85%;
		}
	}
}
