import { Form, Hidden } from "@torpor/ui/Form";
import type UserModel from "../../types/UserModel";
import type ViewingModel from "../../types/ViewingModel";
import type FollowedByPreviewModel from "../../types/contacts/FollowedByPreviewModel";
import FollowPreview from "./FollowPreview.torp";
import FollowMenu from "./FollowMenu.torp";

/**
 * Shows a list of the users who have been blocked.
 */
export default function BlockedPage($props: { data: { viewing: ViewingModel, blocked: FollowedByPreviewModel[], user: UserModel, base: string } }) {
	@head {
		<title>{$props.data.viewing.name} • Blocked • Redraft</title>
	}

	@render {
		<div class="vstack spaced blocked-list">
			<FollowMenu section="Blocked" {$props.data.user} {$props.data.base} />

			<div class="vstack spaced-nr full-width">
				@if ($props.data.blocked.length === 0) {
					<div class="card">
						You haven't blocked anyone.
					</div>
				} else {
					@for (let follow of $props.data.blocked) {
						@key = follow.slug
						<div class="hstack spaced full-width">
							<div class="grow">
								<FollowPreview {follow} {$props.data.user} {$props.data.base} />
							</div>
							<Form action="?/unblock">
								<Hidden name="url" value={follow.url} />
								<button>Unblock</button>
							</Form>
						</div>
					}
				}
			</div>
		</div>
	}
}
