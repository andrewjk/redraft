import type UserModel from "../../types/UserModel";
import type ViewingModel from "../../types/ViewingModel";
import type ProfileViewModel from "../../types/profile/ProfileViewModel";
import ProfileMenu from "./ProfileMenu.torp";
import stripProtocol from "../../lib/utils/stripProtocol";
import Link from "phosphor-torpor/lib/Link";

export default function ProfilePage($props: { data: { profile: ProfileViewModel, user: UserModel, viewing: ViewingModel, base: string } }) {
	@head {
		<title>{$props.data.viewing.name} • Profile • Redraft</title>
	}

	@render {
		<div class="vstack spaced profile-page">
			<ProfileMenu section="Profile" {$props.data.user} {$props.data.base} />

			<div class="vstack spaced-nr profile-identity">
				<h2 class="profile-name">{$props.data.profile.name}</h2>
				<a class="profile-url secondary" href={$props.data.profile.url}>
					{stripProtocol($props.data.profile.url)}
				</a>
			</div>

			@if ($props.data.profile.about) {
				<hr />
				@html($props.data.profile.about)
			}

			@if ($props.data.profile.links.length) {
				<hr />
				<div class="hstack spaced">
					@for (let link of $props.data.profile.links) {
						<a href={link.url} class="hstack centered spaced-nr">
							<Link />
							{link.text}
						</a>
					}
				</div>
			}
		</div>
	}

	@style {
		.profile-name {
			margin-block: 0;
		}

		.profile-url {
			color: var(--text-secondary);
		}

		.profile-image {
			height: 200px;
			width: 200px;
			border: 1px solid var(--border-color);
			border-radius: 50%;
			box-shadow: 0 0.2rem 0.4rem var(--shadow-color);
		}

		.profile-options {
			justify-content: center;
			margin-top: 2rem;
		}
	}
}
