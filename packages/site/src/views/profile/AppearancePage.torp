import { Form, Field, Input, Label, Message } from "@torpor/ui/Form";
import type FormData from "../../types/FormData";
import type UserModel from "../../types/UserModel";
import type ViewingModel from "../../types/ViewingModel";
import type { ThemeModel } from "../../types/theme/ThemeModel";
import { ThemeEditSchema } from "../../types/theme/ThemeSchema";
import {
	darkDefaultTheme,
	darkThemeCss,
	defaultTheme,
	mergeDarkTheme,
	mergeTheme,
	themeCss,
} from "../../lib/theme/theme";
import { DARK_THEME_VARIABLES, THEME_VARIABLES } from "../../lib/theme/themeVariables";
import FormErrors from "../FormErrors.torp";
import ProfileMenu from "./ProfileMenu.torp";

/**
 * Allows the site owner to customize the site's colors, per mode.
 */
export default function AppearancePage($props: { data: { theme: ThemeModel, darkTheme: ThemeModel, viewing: ViewingModel, user: UserModel, base: string }, form?: FormData }) {
	let $state = $watch({
		mode: "light",
		light: mergeTheme($props.data.theme),
		dark: mergeDarkTheme($props.data.darkTheme),
	});

	@head {
		<title>Appearance • Redraft</title>
	}

	@render {
		@// Preview both palettes here, so edits apply live and saved values
		@// show immediately. The header toggle decides which mode is active
		<style>{themeCss($state.light)}</style>
		<style>{darkThemeCss($state.dark)}</style>

		<div class="vstack spaced full-width appearance-page">
			<ProfileMenu section="Appearance" {$props.data.user} {$props.data.base} />

			<p>
				<a href="/account/change-password">Change password</a>
				<span class="separator" />
				<a href="/account/export">Export data</a>
			</p>

			<p>
				Customize the site's colors. Use the theme toggle in the header to
				preview dark mode.
			</p>

			<FormErrors {$props.form} />

			<Form data={{ light: $state.light, dark: $state.dark }} schema={ThemeEditSchema}>
				<div class="hstack centered spaced-nr theme-tabs">
					<button
						type="button"
						class={{ "theme-tab": true, active: $state.mode === "light" }}
						onclick={() => $state.mode = "light"}
					>
						Light
					</button>
					<button
						type="button"
						class={{ "theme-tab": true, active: $state.mode === "dark" }}
						onclick={() => $state.mode = "dark"}
					>
						Dark
					</button>
				</div>

				<div style={{ display: $state.mode === "light" ? undefined : "none" }}>
					@for (let variable of THEME_VARIABLES) {
						<Field class="form-row" name={`light[${variable.name}]`} &value={$state.light[variable.name]}>
							<Label>{variable.label}</Label>
							<div class="hstack centered spaced">
								@if (variable.type === "color") {
									<span class="theme-swatch" style={{ background: $state.light[variable.name] }} />
								}
								<Input placeholder={variable.default} />
							</div>
							<Message class="error-message" />
						</Field>
					}
				</div>

				<div style={{ display: $state.mode === "dark" ? undefined : "none" }}>
					@for (let variable of DARK_THEME_VARIABLES) {
						<Field class="form-row" name={`dark[${variable.name}]`} &value={$state.dark[variable.name]}>
							<Label>{variable.label}</Label>
							<div class="hstack centered spaced">
								<span class="theme-swatch" style={{ background: $state.dark[variable.name] }} />
								<Input placeholder={variable.dark} />
							</div>
							<Message class="error-message" />
						</Field>
					}
				</div>

				<div class="hstack centered spaced">
					<button type="submit">Save</button>
					<button type="button" class="link" onclick={resetTheme}>
						Reset to defaults
					</button>
				</div>
				@function resetTheme() {
					if ($state.mode === "dark") {
						Object.assign($state.dark, darkDefaultTheme());
					} else {
						Object.assign($state.light, defaultTheme());
					}
				}
			</Form>
		</div>
	}

	@style {
		.theme-swatch {
			display: inline-block;
			width: 1.6rem;
			height: 1.6rem;
			flex-shrink: 0;
			border: 1px solid var(--border-color);
			border-radius: var(--border-radius);
		}

		.theme-tabs {
			margin-bottom: 1rem;
		}

		.theme-tab {
			background: none;
			border: 1px solid var(--border-color);
			border-radius: var(--border-radius);
			color: var(--text);
			cursor: pointer;
			min-width: 0;
			padding: 0.4rem 1rem;
		}

		.theme-tab.active {
			background: var(--code-back);
			color: var(--header);
		}
	}
}
