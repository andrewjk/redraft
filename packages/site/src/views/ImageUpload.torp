import { File as FileInput } from "@torpor/ui/Form";
import cleanImage from "../lib/utils/cleanImage";

export default function ImageUpload($props: {
	name?: string,
	image: string | ArrayBuffer | File | null | undefined,
	imageLoaded: boolean,
	circle?: boolean,
	placeholder?: string,
}) {
	async function fileSelected(e: Event) {
		let fileInput = (e.target as HTMLInputElement);
		let image = fileInput.files![0];
		if (!image.type.includes("image")) {
			return;
		}
		image = await cleanImage(image);
		let dataTransfer = new DataTransfer();
		dataTransfer.items.add(image);
		fileInput.files = dataTransfer.files;
		const fileReader = new FileReader();
		fileReader.onload = (ev) => {
			$props.image = ev.target!.result;
			$props.imageLoaded = true;
		}
		fileReader.readAsDataURL(image);
	}

	@render {
		<div class="vstack spaced image-upload">
			@if (!$props.imageLoaded) {
				<FileInput
					class="full-width"
					name={$props.name ?? "imagefile"}
					accept="image/*"
					onchange={fileSelected}
				/>
			}
			<img
				class={{ circle: $props.circle }}
				src={$props.image || $props.placeholder}
			/>
		</div>
	}

	@style {
		img.circle {
			height: 100px;
			width: 100px;
			object-fit: cover;
			border-radius: 50%;
			border: 1px solid var(--border-color);
			box-shadow: 0 0.2rem 0.4rem var(--shadow-color);
		}
	}
}
