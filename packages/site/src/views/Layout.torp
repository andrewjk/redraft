import { $page } from "@torpor/build/state";
import { NavMenu, NavMenuLink } from "@torpor/ui/NavMenu";
import { SegmentedControl, SegmentedItem } from "@torpor/ui/SegmentedControl";
import Bell from "phosphor-torpor/lib/Bell";
import Envelope from "phosphor-torpor/lib/Envelope";
import MoonStars from "phosphor-torpor/lib/MoonStars";
import Sun from "phosphor-torpor/lib/Sun";
//import DotsThreeOutlineVertical from "phosphor-torpor/lib/DotsThreeOutlineVertical";
//import SignOut from "phosphor-torpor/lib/SignOut";
import type UserModel from "../types/UserModel";
import type FollowerModel from "../types/FollowerModel";
import type ViewingModel from "../types/ViewingModel";
import ProfilePreview from "./profile/ProfilePreview.torp";
import placeholdify from "../lib/utils/placeholdify";
import stripProtocol from "../lib/utils/stripProtocol";
import { darkThemeCss, themeCss } from "../lib/theme/theme";

// TODO: should be able to bust out of this layout in SetupPage so we can
// remove the `@if ($props.data.viewing)`

export default function Layout($props: { data: { user: UserModel, follower: FollowerModel, viewing: ViewingModel, base: string }}) {
	@head {
		@if ($props.data.viewing) {
			<meta name="social-follow-url" content={$props.data.viewing.url} />
			<meta name="social-follow-name" content={$props.data.viewing.name} />
			<meta name="social-follow-image" content={$props.data.viewing.image} />
		}
	}

	@render {
		@if ($props.data.viewing?.theme) {
			<style>{themeCss($props.data.viewing.theme)}</style>
		}
		@if ($props.data.viewing?.darkTheme) {
			<style>{darkThemeCss($props.data.viewing.darkTheme)}</style>
		}
		<div class="app-layout">
			@if ($props.data.user) {
				<Nav {$props.data.user} {$props.data.follower} {$props.data.viewing} />
			}

			<main>
				<div class="hstack spaced collapse full-width" style="column-gap: 2.8rem">
					<div class="grow" />

					@if ($props.data.viewing) {
						<div class="vstack centered spaced no-shrink">
							<ProfilePreview
								profile={$props.data.viewing}
								{$props.data.user}
								{$props.data.follower}
								{$props.data.base}
							/>
						</div>
					}

					<div class="vstack centered page-outer">
						<div class="page-inner">
							<slot />
						</div>
					</div>

					<div class="grow" />
				</div>
			</main>
		</div>
	}

	@style {
		main {
			padding: 1rem;
			margin: 0 auto;
		}

		.page-outer {
			width: 100%;
		}

		@media screen and (min-width: 768px) {
			.page-outer {
				max-width: 60rem;
			}
		}

		.page-inner {
			max-width: 60rem;
			width: 100%;
		}
	}
}

function Nav() {
	let $state = $watch({
		theme: "light",
		mounted: false,
	});

	$onmount(() => {
		// The documentElement class is the source of truth for the theme, as
		// it is set before first paint by the inline script in site.html
		$state.theme = document.documentElement.classList.contains("dark") ? "dark" : "light";

		// NOTE: SegmentedControl is only rendered after mount -- it throws when
		// server rendered in a DOM-shimmed environment (e.g. happy-dom tests)
		// because @torpor/view's $cache uses `typeof window` to detect SSR
		$state.mounted = true;

		$run(() => {
			const theme = $state.theme;
			document.documentElement.classList.toggle("dark", theme === "dark");
			try {
				localStorage.setItem("redraft-theme", theme);
			} catch {
				// Private browsing mode etc, theme just won't be persisted
			}
		});
	});

	@render {
		<NavMenu class="nav-bar">
			<ul class="plain hstack centered full-width nav-list">
				<li class="nav-item">
					<NavMenuLink
						class={{ "nav-link": true, active: $page.url.pathname.startsWith("/feed") }}
						href="/feed"
					>
						Feed
					</NavMenuLink>
				</li>

				<div class="spacer" />

				<li class="nav-item">
					<NavMenuLink
						class={{ "nav-link hstack spaced-nr": true, active: $page.url.pathname.startsWith("/profile") }}
						href="/profile"
					>
						<img class="profile-image" src={placeholdify($props.viewing.image)} alt={`${$props.viewing.name} (${stripProtocol($props.viewing.url)})`} />
						<div>{$props.viewing.name}</div>
					</NavMenuLink>
				</li>

				<li class="nav-item">
					<NavMenuLink
						class={{ "nav-link nav-icon": true, active: $page.url.pathname.startsWith("/messages") }}
						href="/messages"
					>
						<div class="badge-container">
							<Envelope size="1.6rem" />
							@if ($props.user.messageCount) {
								<span class="badge">{$props.user.messageCount}</span>
							}
						</div>
					</NavMenuLink>
				</li>

				<li class="nav-item">
					<NavMenuLink
						class={{ "nav-link nav-icon": true, active: $page.url.pathname.startsWith("/notifications") }}
						href="/notifications"
					>
						<div class="badge-container">
							<Bell size="1.6rem" />
							@if ($props.user.notificationCount) {
								<span class="badge">{$props.user.notificationCount}</span>
							}
						</div>
					</NavMenuLink>
				</li>

				<li class="nav-control">
					@if ($state.mounted) {
						<SegmentedControl class="theme-control" ariaLabel="Color theme" &value={$state.theme}>
							<SegmentedItem value="light" class="theme-item">
								<Sun />
							</SegmentedItem>
							<SegmentedItem value="dark" class="theme-item">
								<MoonStars />
							</SegmentedItem>
						</SegmentedControl>
					}
				</li>

				@//<li class="nav-item">
				@//	<NavMenuPopout>
				@//		<NavMenuPopoutButton class="nav-button nav-icon">
				@//			<DotsThreeOutlineVertical weight="bold" size="1.6rem" />
				@//		</NavMenuPopoutButton>
				@//		<NavMenuPopoutContent>
				@//			<NavMenu class="nav-popout" orientation="vertical">
				@//				<NavMenuLink class="nav-link" href="/notifications">
				@//					Notifications
				@//				</NavMenuLink>
				@//				<NavMenuLink class="nav-link" href="/notifications/activity">
				@//					Activity
				@//				</NavMenuLink>
				@//				<NavMenuSeparator class="nav-separator" />
				@//				<NavMenuLink class="nav-link" href="/">
				@//					Home Page
				@//				</NavMenuLink>
				@//				<NavMenuSeparator class="nav-separator" />
				@//				@/*
				@//				<Form action="?/logout">
				@//					<NavMenuButton class="nav-link hstack centered spaced-nr">
				@//						<SignOut weight="bold" />
				@//						Log out
				@//					</NavMenuButton>
				@//				</Form>
				@//				*/
				@//			</NavMenu>
				@//		</NavMenuPopoutContent>
				@//	</NavMenuPopout>
				@//</li>
			</ul>
		</NavMenu>
	}

	@style {
		.nav-bar {
			background-color: var(--surface);
			border-bottom: 1px solid var(--border-color);
			box-shadow: 0 0.2rem 0.4rem var(--shadow-color);
		}

		.nav-link {
			color: inherit;
			display: flex;
			align-items: center;
			user-select: none;
			white-space: nowrap;
			padding: 1rem;
		}

		.nav-button {
			all: unset;
			color: var(--link);
			cursor: pointer;
			display: flex;
			align-items: center;
			user-select: none;
			white-space: nowrap;
			padding: 1rem;
		}

		.nav-link:hover,
		.nav-button:hover {
			background: var(--hover);
			text-decoration: none;
		}

		.nav-link.active {
			border-top: 2px solid #fff0;
			border-bottom: 2px solid var(--highlight, orange);
			padding: calc(1rem - 2px) 1rem;
		}

		.nav-control {
			display: flex;
			padding: 0 1rem 0 0;
		}

		.theme-control {
			border: 1px solid var(--border-color);
			border-radius: var(--border-radius);
			display: flex;
		}

		.theme-item {
			background: none;
			border: none;
			border-radius: calc(var(--border-radius) - 0.15rem);
			color: var(--text);
			cursor: pointer;
			display: inline-flex;
			min-width: 0;
			padding: 0.25rem 0.5rem;
		}

		.theme-item[data-state="active"] {
			background: var(--code-back);
			color: var(--header);
		}

		.nav-popout {
			background-color: var(--surface);
			border: 1px solid var(--border-color);
			border-bottom: 1px solid var(--border-color);
			box-shadow: 0 0.2rem 0.4rem var(--shadow-color);
		}

		.nav-separator {
			width: 100%;
			border-top: 1px solid var(--border-color);
			//margin: 0 1rem;
		}

		.nav-link.nav-icon {
			padding: 1.4rem 1rem;
		}

		.nav-link.nav-icon.active {
			padding: calc(1.4rem - 2px) 1rem;
		}

		.profile-image {
			height: 20px;
			width: 20px;
			border: 1px solid var(--border-color);
			border-radius: 50%;
			box-shadow: 0 0.2rem 0.4rem var(--shadow-color);

			display: inline-block;
			vertical-align: top;
		}

		.badge-container {
			position: relative;
		}

		.badge {
			border-radius: 500px;
			background-color: red;
			color: white;
			font-weight: bold;
			font-size: 70%;
			padding: 0 0.5rem;

			position: absolute;
			top: -1rem;
			right: -1rem;
		}
	}
}
