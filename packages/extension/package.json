{
	"name": "@redraft/extension",
	"version": "0.0.2",
	"description": "The Redraft social web extension",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"check": "tsc --noEmit",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"release:test": "wxt submit --dry-run --chrome-zip .output/*-chrome.zip",
		"release": "wxt submit --chrome-zip .output/*-chrome.zip",
		"release:firefox": "wxt submit --firefox-zip .output/*-firefox.zip --firefox-sources-zip .output/*-sources.zip",
		"postinstall": "wxt prepare"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@torpor/ui": "^1.1.3",
		"@torpor/unplugin": "^1.0.4",
		"@torpor/view": "^1.1.0",
		"phosphor-torpor": "^1.0.2"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"wxt": "^0.20.11"
	}
}
