{
	"name": "@redraft/adapter-cloudflare",
	"version": "0.1.6",
	"description": "A Redraft adapter for deploying to Cloudflare Workers",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./adapter": {
			"types": "./dist/adapter.d.mts",
			"import": "./dist/adapter.mjs"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "tsgo --noEmit",
		"check:todo": "tsgo --noEmit && pnpm dlx oxlint --type-aware",
		"build": "tsgo --noEmit && tsup src/iife.ts --format iife && tsx ./scripts/process.ts && vp pack"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.9.0",
	"dependencies": {
		"@redraft/adapter-core": "workspace:^",
		"@torpor/adapter-cloudflare": "^1.0.5",
		"@torpor/build": "^1.3.0",
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260914.1",
		"@types/node": "^25.9.6",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
